# Isolated ORIGINAL packaged Fincept Qt headless news-service CI runtime.
# Runtime is --network none, read-only rootfs, non-root UID and zero broker env.
# Build time only: apt downloads public Ubuntu packages, no market/provider data.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-pytest \
    libgl1 libegl1 libgles2 libopengl0 libglu1-mesa \
    libfontconfig1 libfreetype6 libx11-6 libx11-xcb1 \
    libxrender1 libxi6 libsm6 libice6 libdbus-1-3 \
    libnss3 libxkbcommon0 libxkbcommon-x11-0 \
    libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-randr0 libxcb-render-util0 libxcb-xinerama0 \
    libxcb-xkb1 libasound2 libpulse0 libgbm1 libdrm2 \
    libxcomposite1 libxdamage1 libxfixes3 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 finceptqa && useradd --uid 10001 --gid finceptqa --create-home finceptqa
USER 10001:10001
WORKDIR /work/repo
